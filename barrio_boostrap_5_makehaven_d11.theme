<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for the projects view.
 *
 * Adds a "Create project" CTA above the grid for users who can create
 * project nodes. Access is delegated to the node create access handler,
 * so anonymous users and roles without the permission see nothing.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_views_view__projects(array &$variables): void {
  $access_handler = \Drupal::entityTypeManager()->getAccessControlHandler('node');
  $access = $access_handler->createAccess('project', NULL, [], TRUE);

  $variables['header']['create_project_action'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['view-projects__actions']],
    '#access' => $access->isAllowed(),
    'link' => [
      '#type' => 'link',
      '#title' => t('+ Create project'),
      '#url' => Url::fromRoute('node.add', ['node_type' => 'project']),
      '#attributes' => ['class' => ['btn', 'btn-primary', 'btn-sm']],
    ],
  ];
  $variables['#cache']['contexts'][] = 'user.permissions';
  CacheableMetadata::createFromRenderArray($variables['header']['create_project_action'])
    ->merge(CacheableMetadata::createFromObject($access))
    ->applyTo($variables['header']['create_project_action']);
}

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function barrio_boostrap_5_makehaven_d11_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
 * Wording for a course by its type.
 *
 * Course nodes describe four different things — a workshop, a program (a
 * multi-week cohort with a coach, e.g. GEMS), a meetup, and a Build & Badge
 * class — and every template used to say "workshop" for all of them. Staff
 * reported the mismatch on the GEMS page twice (ledger #44028, #45066). One
 * table here, read by the course templates and the cohort-list partial, so a
 * new course type is a one-line change and no template hardcodes a noun.
 *
 * @param string|null $type
 *   The field_course_type value.
 *
 * @return array
 *   Keys: single (the thing), instance / instance_plural (one scheduled run
 *   of it), view (catalog-card button label).
 */
function _barrio_boostrap_5_makehaven_d11_course_nouns(?string $type): array {
  switch ($type) {
    case 'program':
      return [
        'type' => 'program',
        'single' => t('program'),
        'instance' => t('cohort'),
        'instance_plural' => t('cohorts'),
        'view' => t('View program'),
      ];

    case 'meetup':
      return [
        'type' => 'meetup',
        'single' => t('meetup'),
        'instance' => t('meetup'),
        'instance_plural' => t('meetups'),
        'view' => t('View meetup'),
      ];

    case 'badge_class':
      return [
        'type' => 'badge_class',
        'single' => t('class'),
        'instance' => t('session'),
        'instance_plural' => t('sessions'),
        'view' => t('View class'),
      ];

    default:
      return [
        'type' => 'workshop',
        'single' => t('workshop'),
        'instance' => t('session'),
        'instance_plural' => t('sessions'),
        'view' => t('View workshop'),
      ];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node.
 *
 * Adds node--course--{type}--{view_mode} so a course type can own its page.
 * Programs use it: a program's course node IS its public page (see
 * node--course--program--full.html.twig), while workshops keep the generic
 * two-column course template.
 */
function barrio_boostrap_5_makehaven_d11_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'course' || !$node->hasField('field_course_type')) {
    return;
  }
  $type = $node->get('field_course_type')->value;
  if ($type === NULL || $type === '') {
    return;
  }
  $view_mode = $variables['elements']['#view_mode'] ?? 'full';
  $suggestions[] = 'node__course__' . $type;
  $suggestions[] = 'node__course__' . $type . '__' . $view_mode;
}

/**
 * Upcoming scheduled runs of a course.
 *
 * CiviCRM events linked by field_parent_course, not templates, active,
 * starting from now. Shared by the course full-page preprocess (sidebar /
 * program cohort list)
 * and the [[COURSE_UPCOMING]] body token. Each row: id, title, date, time,
 * iso, info (event page) and register (registration page) URLs.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The course node.
 * @param int $limit
 *   Maximum rows.
 *
 * @return array
 *   Rows, soonest first. Empty when nothing is scheduled or the CiviCRM
 *   tables are unavailable.
 */
function _barrio_boostrap_5_makehaven_d11_course_upcoming_events(NodeInterface $node, int $limit = 8): array {
  $database = \Drupal::database();
  $rows = [];
  try {
    if (!$database->schema()->tableExists('civicrm_event__field_parent_course')) {
      return [];
    }
    $linked = $database->select('civicrm_event__field_parent_course', 'pc')
      ->fields('pc', ['entity_id'])
      ->condition('pc.field_parent_course_target_id', (int) $node->id())
      ->execute()
      ->fetchCol();
    if (empty($linked)) {
      return [];
    }
    $result = $database->select('civicrm_event', 'e')
      ->fields('e', ['id', 'start_date', 'title'])
      ->condition('e.id', $linked, 'IN')
      ->condition('e.is_template', 0)
      ->condition('e.is_active', 1)
      ->condition('e.start_date', date('Y-m-d H:i:s'), '>=')
      ->orderBy('e.start_date', 'ASC')
      ->range(0, $limit)
      ->execute()
      ->fetchAll();
    foreach ($result as $row) {
      $ts = strtotime($row->start_date);
      $rows[] = [
        'id' => (int) $row->id,
        'title' => (string) $row->title,
        'date' => date('D, M j, Y', $ts),
        'time' => date('g:ia', $ts),
        'iso' => date('c', $ts),
        'url' => '/civicrm-event/' . $row->id,
        'info' => '/civicrm/event/info?id=' . $row->id . '&reset=1',
        'register' => '/civicrm/event/register?id=' . $row->id . '&reset=1',
      ];
    }
  }
  catch (\Throwable $e) {
    return [];
  }
  return $rows;
}

/**
 * A person's public name: first + last name fields when set, else the
 * display name (which for older accounts is the login email).
 */
function _barrio_boostrap_5_makehaven_d11_person_name(\Drupal\user\UserInterface $user): string {
  $first = $user->hasField('field_first_name') ? trim((string) $user->get('field_first_name')->value) : '';
  $last = $user->hasField('field_last_name') ? trim((string) $user->get('field_last_name')->value) : '';
  $name = trim($first . ' ' . $last);
  return $name !== '' ? $name : $user->getDisplayName();
}

/**
 * Whether a formatted-text field holds real text (not just tags or &nbsp;).
 */
function _barrio_boostrap_5_makehaven_d11_text_has_content(?string $html): bool {
  $text = html_entity_decode(strip_tags((string) $html), ENT_QUOTES | ENT_HTML5, 'UTF-8');
  return trim(str_replace("\xC2\xA0", ' ', $text)) !== '';
}

/**
 * Instructor / coach teasers for a course page.
 *
 * Course pages listed instructors as bare name links. A program is chosen as
 * much on who coaches it as on what it covers, and the instructor profiles
 * already carry a photo, a bio and topics — so show a little of each, plus
 * two numbers that speak to experience: sessions taught and the year they
 * started (JR, 2026-09-14). Everything comes from data that exists; nothing
 * new to maintain.
 *
 * @param int[] $uids
 *   Instructor user ids.
 *
 * @return array[]
 *   One row per instructor: name, url, photo (styled URL or ''), initials,
 *   blurb (plain text, ~140 chars), topics (up to 3 labels), sessions (int),
 *   since (year or ''). Ordered by sessions taught, most first.
 */
function _barrio_boostrap_5_makehaven_d11_course_instructor_teasers(array $uids): array {
  if (!$uids) {
    return [];
  }
  $etm = \Drupal::entityTypeManager();
  $database = \Drupal::database();
  $users = $etm->getStorage('user')->loadMultiple($uids);
  /** @var \Drupal\profile\ProfileStorageInterface $profile_storage */
  $profile_storage = $etm->getStorage('profile');
  $style = $etm->getStorage('image_style')->load('medium_square');

  // Experience: every non-template event they have instructed, site-wide.
  $stats = [];
  try {
    $rows = $database->select('civicrm_event__field_civi_event_instructor', 'i');
    $rows->join('civicrm_event', 'e', 'e.id = i.entity_id');
    $rows->addField('i', 'field_civi_event_instructor_target_id', 'uid');
    $rows->addExpression('COUNT(DISTINCT e.id)', 'sessions');
    $rows->addExpression('MIN(e.start_date)', 'first');
    $rows->condition('i.field_civi_event_instructor_target_id', $uids, 'IN')
      ->condition('e.is_template', 0)
      ->condition('e.start_date', date('Y-m-d H:i:s'), '<=')
      ->groupBy('i.field_civi_event_instructor_target_id');
    foreach ($rows->execute() as $r) {
      $stats[(int) $r->uid] = ['sessions' => (int) $r->sessions, 'since' => $r->first ? date('Y', strtotime($r->first)) : ''];
    }
  }
  catch (\Throwable $e) {
    // Teasers still render without the numbers.
  }

  $list = [];
  foreach ($users as $u) {
    $uid = (int) $u->id();
    $name = _barrio_boostrap_5_makehaven_d11_person_name($u);
    $url = $u->toUrl()->toString();
    $photo = '';
    $blurb = '';
    $topics = [];
    $profile = $profile_storage->loadByUser($u, 'instructor');
    if ($profile) {
      $url = $profile->toUrl()->toString();
      if ($profile->hasField('field_instructor_photo') && !$profile->get('field_instructor_photo')->isEmpty()) {
        $file = $profile->get('field_instructor_photo')->entity;
        if ($file && $style) {
          $photo = $style->buildUrl($file->getFileUri());
        }
      }
      if ($profile->hasField('field_instructor_bio')) {
        $text = trim(preg_replace('~\s+~', ' ', strip_tags((string) $profile->get('field_instructor_bio')->value)));
        if (mb_strlen($text) > 150) {
          $cut = mb_substr($text, 0, 150);
          $text = rtrim(mb_substr($cut, 0, (int) mb_strrpos($cut, ' ') ?: 150), " ,;:") . '…';
        }
        $blurb = $text;
      }
      if ($profile->hasField('field_instructor_topics')) {
        foreach ($profile->get('field_instructor_topics')->referencedEntities() as $term) {
          $topics[] = $term->label();
          if (count($topics) === 3) {
            break;
          }
        }
      }
    }
    $parts = preg_split('~\s+~', trim($name)) ?: [];
    $initials = mb_strtoupper(mb_substr($parts[0] ?? '', 0, 1) . mb_substr($parts[count($parts) - 1] ?? '', 0, 1));
    $list[] = [
      'name' => $name,
      'url' => $url,
      'photo' => $photo,
      'initials' => $initials ?: '?',
      'blurb' => $blurb,
      'topics' => $topics,
      'sessions' => $stats[$uid]['sessions'] ?? 0,
      'since' => $stats[$uid]['since'] ?? '',
    ];
  }
  usort($list, static fn($a, $b) => [$b['sessions'], $a['name']] <=> [$a['sessions'], $b['name']]);
  return $list;
}

/**
 * Implements hook_preprocess_node__course().
 *
 * Provides data for the course node full view:
 *  - workshop_upcoming_events: upcoming CiviCRM sessions.
 *  - workshop_instructors: past instructors.
 *  - workshop_flag_link: Flag / login-to-notify link.
 *  - workshop_interest_count: number of interested users.
 *  - workshop_feedback: ['avg' => float, 'count' => int] from webform ratings.
 *  - workshop_runs_count: total historical runs.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_node__course(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $nid = $node->id();
  $database = \Drupal::database();
  $current_user = \Drupal::currentUser();

  $variables['#cache']['contexts'][] = 'user.roles:authenticated';

  // 0. What kind of course this is, and the words that go with it.
  $type = $node->hasField('field_course_type') ? $node->get('field_course_type')->value : NULL;
  $nouns = _barrio_boostrap_5_makehaven_d11_course_nouns($type);
  $variables['course_type'] = $nouns['type'];
  $variables['course_nouns'] = $nouns;
  // Body summary doubles as the banner lead on program pages.
  $variables['course_lead'] = $node->hasField('body')
    ? trim(strip_tags((string) ($node->get('body')->summary ?? '')))
    : '';
  // Staff can place [[COURSE_UPCOMING]] in the body where the cohort list
  // should appear (see preprocess_field); the program template then does
  // not append a second list after the body.
  $variables['course_upcoming_in_body'] = $node->hasField('body')
    && strpos((string) ($node->get('body')->value ?? ''), '[[COURSE_UPCOMING]]') !== FALSE;

  // 1. Notification / Interest Flag.
  try {
    if ($current_user->isAuthenticated()) {
      $variables['workshop_flag_link'] = \Drupal::service('flag.link_builder')
        ->build('node', $nid, 'course_interest', 'workshop_catalog');
    }
    else {
      $variables['workshop_flag_link'] = _barrio_boostrap_5_makehaven_d11_course_signin_prompt($node, $nouns);
    }

    $interest_count = $database->select('flag_counts', 'fc')
      ->fields('fc', ['count'])
      ->condition('fc.flag_id', 'course_interest')
      ->condition('fc.entity_id', (int) $nid)
      ->execute()
      ->fetchField();
    $variables['workshop_interest_count'] = (int) ($interest_count ?: 0);
  }
  catch (\Throwable $e) {}

  // 2. Upcoming Sessions & Instructors.
  try {
    if ($database->schema()->tableExists('civicrm_event__field_parent_course')) {
      $linked_event_ids = $database->select('civicrm_event__field_parent_course', 'pc')
        ->fields('pc', ['entity_id'])
        ->condition('pc.field_parent_course_target_id', (int) $nid)
        ->execute()
        ->fetchCol();

      if (!empty($linked_event_ids)) {
        // Upcoming events (shared helper — also feeds the body token).
        $variables['workshop_upcoming_events'] = _barrio_boostrap_5_makehaven_d11_course_upcoming_events($node);

        // Instructors.
        $instructor_uids = $database->select('civicrm_event__field_civi_event_instructor', 'i')
          ->fields('i', ['field_civi_event_instructor_target_id'])
          ->condition('i.entity_id', $linked_event_ids, 'IN')
          ->distinct()
          ->execute()
          ->fetchCol();

        if (!empty($instructor_uids)) {
          $variables['workshop_instructors'] = _barrio_boostrap_5_makehaven_d11_course_instructor_teasers(array_map('intval', $instructor_uids));
        }

        // 3. Feedback rating — webform_1181 (event_id-linked) + legacy (title-matched).
        $fb_total = 0;
        $fb_count = 0;

        // Source A: webform_1181, matched by event_id (accurate).
        $sids_1181 = $database->select('webform_submission_data', 'eid')
          ->fields('eid', ['sid'])
          ->condition('eid.webform_id', 'webform_1181')
          ->condition('eid.name', 'event_id')
          ->condition('eid.value', $linked_event_ids, 'IN')
          ->execute()
          ->fetchCol();

        if (!empty($sids_1181)) {
          $ratings = $database->select('webform_submission_data', 'r')
            ->fields('r', ['value'])
            ->condition('r.webform_id', 'webform_1181')
            ->condition('r.name', 'overall_how_satisfied_were_you_with_the_event')
            ->condition('r.sid', $sids_1181, 'IN')
            ->execute()
            ->fetchCol();
          foreach ($ratings as $val) {
            $v = (int) $val;
            if ($v >= 1 && $v <= 5) { $fb_total += $v; $fb_count++; }
          }
        }

        // Source B: legacy webforms matched by event title.
        $titles = $database->select('civicrm_event', 'e')
          ->fields('e', ['title'])
          ->condition('e.id', $linked_event_ids, 'IN')
          ->execute()
          ->fetchCol();

        if (!empty($titles)) {
          foreach ([['webform_26478', 'workshop'], ['evaluation', 'name']] as [$wid, $title_key]) {
            $legacy_sids = $database->select('webform_submission_data', 'lt')
              ->fields('lt', ['sid'])
              ->condition('lt.webform_id', $wid)
              ->condition('lt.name', $title_key)
              ->condition('lt.value', $titles, 'IN')
              ->execute()
              ->fetchCol();
            if (empty($legacy_sids)) {
              continue;
            }
            $ratings = $database->select('webform_submission_data', 'lr')
              ->fields('lr', ['value'])
              ->condition('lr.webform_id', $wid)
              ->condition('lr.name', 'overall')
              ->condition('lr.sid', $legacy_sids, 'IN')
              ->execute()
              ->fetchCol();
            foreach ($ratings as $val) {
              $v = (int) $val;
              if ($v >= 1 && $v <= 5) { $fb_total += $v; $fb_count++; }
            }
          }
        }

        $variables['workshop_feedback'] = $fb_count > 0
          ? ['avg' => round($fb_total / $fb_count, 1), 'count' => $fb_count]
          : ['avg' => 0.0, 'count' => 0];
      }
    }
  }
  catch (\Throwable $e) {}

  // 4. Stats.
  $variables['workshop_runs_count'] = (int) ($node->get('field_stat_runs')->value ?? 0);
}

/**
 * The signed-out "follow this course" prompt.
 *
 * Following needs an account, but the account a follower needs is the basic
 * kind — not the member sign-up. Before 2026-09-14 the prompt's "Register"
 * link sent people to /user/register, which greeted them with "Member setup,
 * step 3 of 8" and a ten-field form with a waiver (JR, on the GEMS page). So
 * the prompt now leads with Google sign-in, which creates the basic account
 * with no form and returns to this page (social_auth honours ?destination=),
 * and keeps log in / create account as the quiet alternatives.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The course node.
 * @param array $nouns
 *   From _barrio_boostrap_5_makehaven_d11_course_nouns().
 *
 * @return array
 *   Render array.
 */
function _barrio_boostrap_5_makehaven_d11_course_signin_prompt(NodeInterface $node, array $nouns): array {
  $dest = $node->toUrl()->toString();
  $query = ['query' => ['destination' => $dest]];
  $lead = $nouns['type'] === 'program'
    ? t('Sign in to follow this program and hear first when the next @instance opens.', ['@instance' => $nouns['instance']])
    : t('Sign in to follow this @single and hear when it is next scheduled.', ['@single' => $nouns['single']]);

  $build = [
    '#type' => 'container',
    '#attributes' => ['class' => ['workshop-auth-prompt', 'course-signin']],
    'lead' => ['#markup' => '<p class="course-signin__lead">' . $lead . '</p>'],
  ];
  if (\Drupal::moduleHandler()->moduleExists('social_auth_google')) {
    $build['google'] = [
      '#type' => 'link',
      '#title' => t('Continue with Google'),
      '#url' => Url::fromRoute('social_auth.network.redirect', ['network' => 'google'], $query),
      '#attributes' => ['class' => ['btn', 'btn-outline-dark', 'mh-google-btn'], 'rel' => 'nofollow'],
    ];
  }
  $build['alt'] = [
    '#markup' => '<p class="course-signin__alt small">'
      . t('or <a href=":login" class="login-to-notify">log in</a> · <a href=":register" class="register-to-notify">create a free account</a>', [
        ':login' => Url::fromRoute('user.login', [], $query)->toString(),
        ':register' => Url::fromRoute('user.register', [], $query)->toString(),
      ])
      . '</p>',
  ];
  return $build;
}

/**
 * Implements hook_preprocess_HOOK() for login_with (social_auth's button row).
 *
 * The block never passes a destination, so a visitor who signed in with
 * Google from /user/register?destination=/gems landed on /user instead of
 * back on the page they came from. Carry the current request's internal
 * ?destination= through; the template already knows what to do with it.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_login_with(array &$variables): void {
  if (!empty($variables['destination'])) {
    return;
  }
  $destination = (string) \Drupal::request()->query->get('destination', '');
  if ($destination !== '' && $destination[0] === '/' && !str_starts_with($destination, '//')) {
    $variables['destination'] = $destination;
    $variables['#cache']['contexts'][] = 'url.query_args:destination';
  }
}

/**
 * Implements hook_preprocess_node__course__program__full().
 *
 * Drupal runs preprocess for the base hook (node) and for the exact template
 * hook that renders, not for intermediate suggestions — so the program page
 * template (node--course--program--full) would not get the course variables
 * unless this delegates.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_node__course__program__full(array &$variables): void {
  barrio_boostrap_5_makehaven_d11_preprocess_node__course($variables);
}

/**
 * Implements hook_preprocess_node__course__teaser().
 *
 * The catalog view at /workshops renders course nodes in teaser view mode.
 * The full-view hook (above) does heavy CiviCRM queries; for the catalog
 * card we only need the denormalized stat fields maintained by
 * instructor_companion's CourseStatsSync — fast, no joins.
 *
 * Sets:
 *  - workshop_runs_count: lifetime instance count (field_stat_runs).
 *  - workshop_upcoming_count: scheduled future instances (field_stat_upcoming).
 *  - attributes.class += 'course-teaser--member-only' on badge_class courses
 *    so workshops.css renders a "Member Only" chip on the card.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_node__course__teaser(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  // Denormalized stats — set by instructor_companion.stats_sync on save.
  $variables['workshop_runs_count'] = $node->hasField('field_stat_runs')
    ? (int) ($node->get('field_stat_runs')->value ?? 0)
    : 0;
  $variables['workshop_upcoming_count'] = $node->hasField('field_stat_upcoming')
    ? (int) ($node->get('field_stat_upcoming')->value ?? 0)
    : 0;

  $type = $node->hasField('field_course_type') ? $node->get('field_course_type')->value : NULL;
  $variables['course_type'] = $type;
  $variables['course_nouns'] = _barrio_boostrap_5_makehaven_d11_course_nouns($type);
  if ($type) {
    $variables['attributes']['class'][] = 'course-teaser--' . $type;
  }

  // Member-only registration marker.
  if ($type === 'badge_class') {
    $variables['attributes']['class'][] = 'course-teaser--member-only';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function barrio_boostrap_5_makehaven_d11_preprocess_node(&$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  if ($node->getType() === 'landing_page') {
    $variables['#attached']['library'][] = 'barrio_boostrap_5_makehaven_d11/landing_page';
  }

  if (
    $node->getType() === 'reservation'
    && !empty($variables['view_mode'])
    && in_array($variables['view_mode'], ['full', 'default'], TRUE)
  ) {
    $variables['reservation_page'] = _barrio_boostrap_5_makehaven_d11_build_reservation_page_data($node);
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * Swaps live-content tokens left in a node body for their rendered widget:
 *  - [[COURSE_UPCOMING]] on any course node → that course's upcoming runs.
 *  - [[GEMS_UPCOMING]] (legacy, old /gems page node) → gems_cohorts View block.
 *  - [[WORKSPACE_AVAILABILITY]] on /workspace (node 3890) → the
 *    workspace_listing block (available units from the workspace_rental module).
 *
 * Both bodies stay fully staff-editable; the token marks where the live widget
 * goes, so the list is never hand-maintained. This hooks the body FIELD rather
 * than the node because these pages can render through Layout Builder, which
 * nests the body field-block away from $variables['content']['body'] where a
 * hook_preprocess_node would reach it. The field hook fires either way.
 *
 * Each widget's cache metadata is bubbled onto the field so the underlying data
 * (a new cohort event, a new rental agreement) invalidates the page; an hourly
 * max-age backstops any missed invalidation.
 *
 * renderInIsolation() also DISCARDS #attached, so each widget's libraries and
 * drupalSettings are re-attached to the field explicitly — without that the
 * markup lands on the page with no CSS or JS behind it (the workspace
 * floorplan renders as black boxes with no availability state). See
 * _barrio_boostrap_5_makehaven_d11_embed_widget().
 */
function barrio_boostrap_5_makehaven_d11_preprocess_field(array &$variables): void {
  if (
    ($variables['field_name'] ?? '') !== 'body'
    || !($variables['element']['#object'] ?? NULL) instanceof NodeInterface
    || empty($variables['items'][0]['content']['#text'])
  ) {
    return;
  }
  $nid = (int) $variables['element']['#object']->id();
  $text = $variables['items'][0]['content']['#text'];

  // Any course node — [[COURSE_UPCOMING]] → the course's own upcoming runs
  // (events linked by field_parent_course), rendered with the same partial
  // the program template uses. Lets staff put the cohort list mid-page,
  // between the overview and the schedule, instead of at the bottom.
  $node = $variables['element']['#object'];
  if ($node->bundle() === 'course' && strpos($text, '[[COURSE_UPCOMING]]') !== FALSE) {
    $type = $node->hasField('field_course_type') ? $node->get('field_course_type')->value : NULL;
    $build = [
      '#type' => 'inline_template',
      '#template' => "{% include '@barrio_boostrap_5_makehaven_d11/content/course-cohorts.html.twig' with { events: events, nouns: nouns } only %}",
      '#context' => [
        'events' => _barrio_boostrap_5_makehaven_d11_course_upcoming_events($node),
        'nouns' => _barrio_boostrap_5_makehaven_d11_course_nouns($type),
      ],
      '#cache' => ['tags' => ['civicrm_event_list'], 'max-age' => 3600],
    ];
    _barrio_boostrap_5_makehaven_d11_embed_widget($variables, '[[COURSE_UPCOMING]]', $build);
    return;
  }

  // Legacy: [[GEMS_UPCOMING]] → gems_cohorts View block. Was the /gems page
  // node (30278) before GEMS moved onto its course node (2026-09-12); kept
  // so an old body still renders if the content port has not run yet.
  if (strpos($text, '[[GEMS_UPCOMING]]') !== FALSE) {
    $build = views_embed_view('gems_cohorts', 'block_1');
    _barrio_boostrap_5_makehaven_d11_embed_widget($variables, '[[GEMS_UPCOMING]]', $build);
    return;
  }

  // /workspace — live "Available Workspaces" listing (a block plugin, not a
  // View: workspace_listing_block reads the workspace + rental_agreement
  // entities). Replaces the old hand-maintained availability table.
  if ($nid === 3890 && strpos($text, '[[WORKSPACE_AVAILABILITY]]') !== FALSE) {
    try {
      $build = \Drupal::service('plugin.manager.block')
        ->createInstance('workspace_listing_block', [])
        ->build();
    }
    catch (\Throwable $e) {
      // workspace_rental unavailable — drop the token rather than print it raw.
      $variables['items'][0]['content']['#text'] = str_replace('[[WORKSPACE_AVAILABILITY]]', '', $text);
      return;
    }
    _barrio_boostrap_5_makehaven_d11_embed_widget($variables, '[[WORKSPACE_AVAILABILITY]]', $build);
  }
}

/**
 * Renders a widget into a body token, carrying its assets and cache metadata.
 *
 * Rendering in isolation is what lets these widgets render from inside a
 * preprocess hook without a "render context" error, but renderInIsolation()
 * throws away everything the widget bubbled up. Cache metadata was re-applied;
 * #attached was not, so a widget's own CSS/JS only reached the page if some
 * OTHER element on it happened to attach the same library. The workspace
 * floorplan did exactly that — it borrowed its library from a duplicate block
 * placement of the same listing, and rendered as unstyled black boxes the
 * moment that duplicate was removed.
 *
 * @param array $variables
 *   The body field's preprocess variables, altered in place.
 * @param string $token
 *   The token to replace, e.g. '[[WORKSPACE_AVAILABILITY]]'.
 * @param array $build
 *   The widget render array. Passed by value here but rendered by reference
 *   below, so post-render it carries the bubbled #attached.
 */
function _barrio_boostrap_5_makehaven_d11_embed_widget(array &$variables, string $token, array $build): void {
  $html = (string) \Drupal::service('renderer')->renderInIsolation($build);
  $content =& $variables['items'][0]['content'];
  $content['#text'] = str_replace($token, $html, $content['#text']);

  $content['#attached'] = BubbleableMetadata::mergeAttachments(
    $content['#attached'] ?? [],
    $build['#attached'] ?? []
  );

  CacheableMetadata::createFromRenderArray($build)
    ->merge(CacheableMetadata::createFromRenderArray($content))
    ->setCacheMaxAge(3600)
    ->applyTo($content);
}

/**
 * Build structured reservation display data for the reservation full node view.
 */
function _barrio_boostrap_5_makehaven_d11_build_reservation_page_data(NodeInterface $node): array {
  $date_formatter = \Drupal::service('date.formatter');
  $file_url_generator = \Drupal::service('file_url_generator');
  $image_style_storage = \Drupal::entityTypeManager()->getStorage('image_style');
  $thumbnail_style = $image_style_storage->load('thumbnail');
  $status_value = (string) ($node->get('field_reservation_status')->value ?? '');
  $purpose_value = (string) ($node->get('field_reservation_purpose')->value ?? '');
  $cancelled = (string) ($node->get('field_reservation_cancellation')->value ?? '') === '1';

  $sessions = [];
  $seen_sessions = [];
  $duplicate_sessions_collapsed = 0;
  foreach ($node->get('field_reservation_time_range') as $item) {
    $start_raw = (string) $item->value;
    $end_raw = (string) $item->end_value;
    if ($start_raw === '' || $end_raw === '') {
      continue;
    }

    $key = $start_raw . '|' . $end_raw;
    if (isset($seen_sessions[$key])) {
      $duplicate_sessions_collapsed++;
      continue;
    }
    $seen_sessions[$key] = TRUE;

    $start_ts = strtotime($start_raw . ' UTC');
    $end_ts = strtotime($end_raw . ' UTC');
    if ($start_ts === FALSE || $end_ts === FALSE) {
      continue;
    }

    $sessions[] = [
      'key' => $key,
      'start_ts' => $start_ts,
      'end_ts' => $end_ts,
      'date_label' => $date_formatter->format($start_ts, 'custom', 'D, M j, Y'),
      'time_label' => $date_formatter->format($start_ts, 'custom', 'g:i a') . ' - ' . $date_formatter->format($end_ts, 'custom', 'g:i a'),
      'duration_hours' => round(max(0, $end_ts - $start_ts) / 3600, 2),
    ];
  }

  usort($sessions, static function (array $a, array $b): int {
    return $a['start_ts'] <=> $b['start_ts'];
  });

  $overall = NULL;
  if (!empty($sessions)) {
    $first = reset($sessions);
    $last = end($sessions);
    $overall = [
      'from' => $date_formatter->format($first['start_ts'], 'custom', 'D, M j, Y g:i a'),
      'to' => $date_formatter->format($last['end_ts'], 'custom', 'D, M j, Y g:i a'),
    ];
  }

  $assets = [];
  $seen_assets = [];
  $duplicate_assets_collapsed = 0;
  foreach ($node->get('field_reservation_asset')->referencedEntities() as $asset_node) {
    $asset_id = (int) $asset_node->id();
    if (isset($seen_assets[$asset_id])) {
      $duplicate_assets_collapsed++;
      continue;
    }
    $seen_assets[$asset_id] = TRUE;
    $image_url = NULL;
    $image_alt = '';
    if ($asset_node->hasField('field_item_image') && !$asset_node->get('field_item_image')->isEmpty()) {
      $image_item = $asset_node->get('field_item_image')->first();
      if ($image_item && $image_item->entity) {
        $file_uri = $image_item->entity->getFileUri();
        if ($thumbnail_style) {
          $image_url = $thumbnail_style->buildUrl($file_uri);
        }
        else {
          $image_url = $file_url_generator->generateString($file_uri);
        }
        $image_alt = (string) ($image_item->alt ?? '');
      }
    }

    $assets[] = [
      'title' => $asset_node->label(),
      'url' => $asset_node->toUrl()->toString(),
      'image_url' => $image_url,
      'image_alt' => $image_alt !== '' ? $image_alt : $asset_node->label(),
    ];
  }

  $related_event = NULL;
  $civicrm_event_id = (int) ($node->get('field_reservation_civicrm_event')->target_id ?? 0);
  if ($civicrm_event_id > 0) {
    $related_event_title = '';

    // Prefer explicitly linked event node title when present.
    if ($node->hasField('field_reservation_event') && !$node->get('field_reservation_event')->isEmpty()) {
      $event_node = $node->get('field_reservation_event')->entity;
      if ($event_node) {
        $related_event_title = trim((string) $event_node->label());
      }
    }

    // Fall back to CiviCRM event title by event ID.
    if ($related_event_title === '') {
      try {
        $database = \Drupal::database();
        if ($database->schema()->tableExists('civicrm_event')) {
          $title = $database->select('civicrm_event', 'ce')
            ->fields('ce', ['title'])
            ->condition('id', $civicrm_event_id)
            ->range(0, 1)
            ->execute()
            ->fetchField();
          if (is_string($title) && trim($title) !== '') {
            $related_event_title = trim($title);
          }
        }
      }
      catch (\Throwable $e) {
        // Keep fallback label if CiviCRM table is unavailable in this context.
      }
    }

    $related_event = [
      'label' => 'Related Event',
      'url' => Url::fromUri('internal:/civicrm/event/info', [
        'query' => [
          'id' => $civicrm_event_id,
          'reset' => 1,
        ],
      ])->toString(),
      'event_id' => $civicrm_event_id,
      'event_title' => $related_event_title !== '' ? $related_event_title : 'Event ' . $civicrm_event_id,
    ];
  }

  return [
    'status' => $status_value !== '' ? ucfirst($status_value) : 'Unknown',
    'purpose' => $purpose_value !== '' ? ucfirst($purpose_value) : 'Not set',
    'cancelled' => $cancelled,
    'sessions' => $sessions,
    'overall' => $overall,
    'assets' => $assets,
    'notes' => $node->get('body')->view(['label' => 'hidden']),
    'related_event' => $related_event,
    'duplicate_sessions_collapsed' => $duplicate_sessions_collapsed,
    'duplicate_assets_collapsed' => $duplicate_assets_collapsed,
  ];
}

/**
 * Implements hook_preprocess_paragraph().
 */
function barrio_boostrap_5_makehaven_d11_preprocess_paragraph(&$variables) {
  if (empty($variables['paragraph'])) {
    return;
  }

  if ($variables['paragraph']->bundle() !== 'landing_section_feature_grid') {
    return;
  }

  $variables['#attached']['library'][] = 'barrio_boostrap_5_makehaven_d11/landing_page';
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function barrio_boostrap_5_makehaven_d11_preprocess_views_view_field(array &$variables) {
  // Member-only chip on /events: prepend a chip to the title field for any
  // civicrm_event row whose event_type_id is a member-only type (10 = Member
  // Event, 16 = Ticketed Member Only). The listing stays mixed (public and
  // member-only together) so the chip serves to promote / inform.
  if (!empty($variables['view'])
      && $variables['view']->id() === 'event_set'
      && !empty($variables['field']) && $variables['field']->field === 'title'
      && !empty($variables['row']->_entity)
      && $variables['row']->_entity->getEntityTypeId() === 'civicrm_event') {
    $entity = $variables['row']->_entity;
    $type_id = (int) ($entity->get('event_type_id')->value ?? 0);
    if (in_array($type_id, [10, 16], TRUE)) {
      $chip = '<span class="event-card-chip event-card-chip--member-only">' . t('Member Only') . '</span> ';
      // Output may be a string or a Markup object — coerce safely.
      $variables['output'] = \Drupal\Core\Render\Markup::create($chip . (string) $variables['output']);
    }
  }

  if (empty($variables['output']) || !is_string($variables['output'])) {
    return;
  }

  // Guardrail: tokenized custom text fields can accidentally include nested
  // rendered field output with Twig debug comments when theme debug is on.
  if (strpos($variables['output'], 'THEME DEBUG') === FALSE) {
    return;
  }

  $clean = preg_replace('/<!--[\s\S]*?-->/', '', $variables['output']);
  if ($clean === NULL) {
    return;
  }

  // Keep author-provided markup, but normalize whitespace around removed
  // comments to prevent odd spacing.
  $clean = preg_replace('/\s{2,}/', ' ', $clean);
  $output = trim($clean);

  if ($output === '' && !empty($variables['view']) && $variables['view']->id() === 'reservations_referencing_civicrm_event' && $variables['display_id'] === 'event_registration_button') {
    $output = t('Reservation: Not linked');
  }

  $variables['output'] = $output;
}

/**
 * Implements hook_theme().
 *
 * Registers the calendar-legend template used on calendar pages (events +
 * reservations).
 */
function barrio_boostrap_5_makehaven_d11_theme($existing, $type, $theme, $path) {
  return [
    'calendar_legend' => [
      'variables' => ['items' => []],
      'template' => 'calendar-legend',
    ],
  ];
}

/**
 * Returns the calendar event-color legend render array.
 *
 * Color/label list mirrors the fullcalendar_view color bundle for the events
 * calendar. Centralized here so both the events and reservations calendars
 * render the same legend without duplication.
 */
function _barrio_boostrap_5_makehaven_d11_calendar_legend(): array {
  return [
    '#theme' => 'calendar_legend',
    '#items' => [
      ['color' => '#b8860b', 'label' => t('Workshop')],
      ['color' => '#5f9ea0', 'label' => t('Program')],
      ['color' => '#006400', 'label' => t('Public Event (Free)')],
      ['color' => '#4b0082', 'label' => t('Meetup')],
      ['color' => '#000000', 'label' => t('Member Event')],
      ['color' => '#3a87ad', 'label' => t('Meeting')],
      ['color' => '#ff7f50', 'label' => t('Team Based')],
      ['color' => '#ed143d', 'label' => t('Fundraiser')],
      ['color' => '#8a2be2', 'label' => t('Partner Hosted')],
      ['color' => '#a52a2a', 'label' => t('Co-Hosted')],
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Injects the calendar event-color legend into the view's header on the
 * public events calendar and the reservations calendar — placing it directly
 * under the page title and above the calendar grid (better UX than the
 * site-region featured_top, which sat above the breadcrumb).
 *
 * Pure theme code — no asset_injector entity, no block_content. The view's
 * `header` slot renders inside the view wrapper, after the page title.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view === NULL) {
    return;
  }
  $is_calendar = ($view->id() === 'events_calendar' && $view->current_display === 'page_3')
    || ($view->id() === 'reservatioubs' && $view->current_display === 'reservation_calendar');
  if (!$is_calendar) {
    return;
  }

  // The view's `header` is rendered as an array of items keyed by area
  // plugin id. Prepend our legend so it lands above any existing area output.
  $legend = _barrio_boostrap_5_makehaven_d11_calendar_legend();
  $variables['header'] = ['calendar_legend' => $legend] + ($variables['header'] ?? []);
}

/**
 * The item_category term IDs that mark an item node as a Room/Zone.
 * @see /rooms view (views.view.rooms) filter.
 */
const BARRIO_MH_ROOM_CATEGORY_TIDS = [472, 2341];

/**
 * Whether the given node is a Room/Zone (so it belongs under /rooms).
 */
function _barrio_boostrap_5_makehaven_d11_is_room(?NodeInterface $node): bool {
  if (!$node instanceof NodeInterface || $node->bundle() !== 'item' || !$node->hasField('field_item_category')) {
    return FALSE;
  }
  $tids = array_column($node->get('field_item_category')->getValue(), 'target_id');
  return (bool) array_intersect($tids, BARRIO_MH_ROOM_CATEGORY_TIDS);
}

/**
 * Build the breadcrumb trail for a "banner page".
 *
 * Banner pages are View pages and special nodes that can't carry the mockup's
 * node-body markup, but should still get a full-bleed red banner with the
 * breadcrumb pill injected into the page-title block (see
 * THEME_preprocess_block + css/pages/rooms.css). Covers: Rooms / Member
 * Businesses / Blog views, Room/Zone item nodes, and the Instructor Interest
 * webform. Views are matched by route name (stable across environments); the
 * node cases use ids/categories that are stable because the dev DB shares the
 * production lineage.
 *
 * @return array|null
 *   List of [text, url|null] pairs (last entry = current page, no url), or NULL.
 */
function _barrio_boostrap_5_makehaven_d11_mh_banner_crumb(): ?array {
  $route_match = \Drupal::routeMatch();
  $membership = '/membership-information-members';
  $programming = '/programs';
  $resources = '/resources';

  // CiviCRM event INFO pages (any event). All /civicrm/* paths share one
  // route, so match by path. The event title shows in the banner heading;
  // the pill links back to the events listing.
  if (strpos(\Drupal::service('path.current')->getPath(), '/civicrm/event/info') === 0) {
    return [['Home', '/'], ['Events', '/events'], ['Event Details', NULL]];
  }

  // View pages, keyed by route name (stable across environments). Value is the
  // trail AFTER Home: [..parents.., [current page, NULL]].
  $views = [
    // Site search results — reachable from the header search box on every
    // page, so the crumb is the only way back out of a results list. The
    // site_search view serves /search under core's existing route name,
    // so this is keyed 'search.view' rather than 'view.site_search.page_1'.
    'search.view'                       => [['Search', NULL]],
    'view.rooms.page_1'                 => [['Rooms', NULL]],
    'view.businesses.incubating'        => [['About', '/about-us'], ['Member Businesses', NULL]],
    'view.blog.page_1'                  => [['About', '/about-us'], ['Blog', NULL]],
    'view.event_set.all_upcoming'       => [['Programming', $programming], ['Upcoming Events', NULL]],
    'view.events_calendar.page_3'       => [['Programming', $programming], ['Calendar', NULL]],
    'view.public_course_catalog.page_1' => [['Programming', $programming], ['Workshops', NULL]],
    // Resources tab. /equipment 301s to /rooms/zones/equipment; both hit this
    // view route. /business/products is a custom controller route (not a view)
    // but matches here the same way since it renders a page-title block.
    'view.equipment.page_1'                     => [['Resources', $resources], ['Equipment', NULL]],
    'view.library_tool_directory.library_list'  => [['Resources', $resources], ['Lending Library', NULL]],
    'view.resources.page_2'                     => [['Resources', $resources], ['Suppliers & Resources', NULL]],
    'view.projects.page_1'                      => [['Resources', $resources], ['Projects', NULL]],
    'makerspace_business_visibility.products'   => [['Resources', $resources], ['Shop Local Makers', NULL]],
    // Sponsors is a View of sponsor content (the hand-built node body it
    // replaced is parked at /sponsors-old). Trail matches the crumb the
    // redesigned page carried: Home / Donate / Sponsors.
    'view.sponsors.page_1'                      => [['Donate', '/donate-makehaven'], ['Sponsors', NULL]],
    // Remaining public listings — the visitor-facing pages still without a
    // crumb after the sections above. Parents follow the main menu.
    'view.public_program_catalog.page_1'        => [['Programming', NULL]],
    'view.event_set.page_3'                     => [['Programming', $programming], ['Ticketed Workshops', NULL]],
    'view.event_set.public_events'              => [['Programming', $programming], ['Public Events', NULL]],
    'view.event_set.events_past'                => [['Programming', $programming], ['Past Events', NULL]],
    'view.event_set.member_events'              => [['Programming', $programming], ['Member Events', NULL]],
    'view.instructors.page_1'                   => [['Programming', $programming], ['Instructors', NULL]],
    'view.policies.page_1'                      => [['About', '/about-us'], ['Policies', NULL]],
    'view.companies.page_1'                     => [['About', '/about-us'], ['Member Companies', NULL]],
    'view.store.page_1'                         => [['Resources', $resources], ['Store', NULL]],
    'view.badges.page_1'                        => [['Resources', $resources], ['Badges', NULL]],
    'view.resources.page_3'                     => [['Resources', $resources], ['Discounts', NULL]],
    'view.projects.page_2'                      => [['Resources', $resources], ['Completed Projects', NULL]],
    'view.rooms.page_2'                         => [['Rooms', '/rooms'], ['Zones', NULL]],
  ];
  $route = $route_match->getRouteName();
  if (isset($views[$route])) {
    return array_merge([['Home', '/']], $views[$route]);
  }

  $node = $route_match->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return NULL;
  }

  // Room / Zone item node → Home / Rooms / {title}.
  if (_barrio_boostrap_5_makehaven_d11_is_room($node)) {
    return [['Home', '/'], ['Rooms', '/rooms'], [$node->label(), NULL]];
  }
  // Any blog post → Home / About / Blog / {title}.
  if ($node->bundle() === 'blog') {
    return [['Home', '/'], ['About', '/about-us'], ['Blog', '/blog'], [$node->label(), NULL]];
  }
  // Any library tool detail → Home / Resources / Lending Library / {title}.
  if ($node->bundle() === 'library_item') {
    return [['Home', '/'], ['Resources', $resources], ['Lending Library', '/library'], [$node->label(), NULL]];
  }

  // Section landing pages whose own title IS the section → 2-level crumb
  // (Home / {section}) with no self-link.
  $section_landings = [
    619   => 'Resources',                        // /resources tab landing.
    1     => 'About',                            // /about-us.
    // NB: /membership-information-members (35973) is intentionally NOT here.
    // Unlike the other redesigned pages, its node body DID receive the
    // redesign's styled hero (".join-gift-section" → its own <h1> + lead), so
    // it already renders a visible heading. Registering it would unhide the
    // theme page-title block and stack a second <h1> above that hero. It keeps
    // its title block hidden via css/pages/membership.css.
    37638 => 'Donate',                           // /donate-makehaven.
    8205  => 'Visit',                            // /visit.
  ];
  $section_id = (int) $node->id();
  if (isset($section_landings[$section_id])) {
    return [['Home', '/'], [$section_landings[$section_id], NULL]];
  }

  // Specific nodes → [parent label, parent url] with an optional third element
  // overriding the crumb's own label (node titles like "990 Tax Forms and
  // Financial Information" are too long for the pill). Parents follow the main
  // menu. IDs are stable because the dev DB shares the production lineage.
  $node_parents = [
    14366 => ['About', '/about-us'],              // Instructor Interest webform.
    41379 => ['Membership', $membership],         // Membership Agreement.
    332   => ['Membership', $membership],         // Gift a Membership.
    707   => ['Membership', $membership],         // Membership Overview (landing).
    14254 => ['Programming', $programming],       // Private Classes webform.
    16200 => ['Programming', $programming],       // Event Gift Card.
    3143  => ['Resources', $resources],           // Room Rentals webform.
    // Redesigned marketing pages. These hid the theme page-title block while
    // waiting on a node-body banner that was never applied to production,
    // leaving them with no visible heading — the theme supplies it instead.
    427   => ['About', '/about-us'],              // Team.
    413   => ['About', '/about-us'],              // Work at MakeHaven.
    29374 => ['About', '/about-us'],              // Teach a Workshop.
    5045  => ['About', '/about-us', 'FAQ'],
    13706 => ['About', '/about-us', 'Financial Information'],
    27700 => ['Programming', $programming],       // Team-Building Workshops.
    // NB: /gems (30278) is intentionally NOT here. Like /membership, its node
    // body carries its own .mh-page__banner hero (heading + crumb pill + lead),
    // so registering it would stack a second theme-rendered heading above that
    // banner. It keeps the theme page-title block hidden via css/pages/gems.css.
    3890  => ['Resources', $resources],           // Workspaces for Makers.
    24707 => ['Membership', $membership],         // Join MakeHaven.
  ];
  $id = (int) $node->id();
  if (isset($node_parents[$id])) {
    [$parent_label, $parent_url] = $node_parents[$id];
    $self = $node_parents[$id][2] ?? $node->label();
    return [['Home', '/'], [$parent_label, $parent_url], [$self, NULL]];
  }
  return NULL;
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb.
 *
 * Sets a sensible trail on banner pages. (The standalone breadcrumb block is
 * hidden via CSS — the visible pill is injected in preprocess_block — but this
 * keeps the breadcrumb data correct for accessibility / other render contexts.)
 */
function barrio_boostrap_5_makehaven_d11_preprocess_breadcrumb(&$variables) {
  $crumb = _barrio_boostrap_5_makehaven_d11_mh_banner_crumb();
  if (!$crumb) {
    return;
  }
  $links = [];
  $last = count($crumb) - 1;
  foreach ($crumb as $i => [$text, $url]) {
    $item = ['text' => $text];
    if ($url !== NULL && $i !== $last) {
      $item['url'] = $url;
    }
    $links[] = $item;
  }
  $variables['breadcrumb'] = $links;
  $variables['#cache']['contexts'][] = 'url.path';
}

/**
 * Implements hook_preprocess_HOOK() for views-view-unformatted--instructors.
 *
 * The /instructors directory rendered every profile as its full two-column
 * page, newest profile first — 35 full bios, 24,000 pixels, no way to tell
 * who actually teaches (JR, 2026-09-14). The View still does the filtering
 * (active instructors, topic facet); the theme renders the rows as the same
 * teaser cards the course pages use, ordered by sessions taught then name.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_views_view_unformatted__instructors(array &$variables): void {
  $uids = [];
  foreach ($variables['view']->result as $row) {
    $entity = $row->_entity ?? NULL;
    if ($entity && method_exists($entity, 'getOwnerId') && $entity->getOwnerId()) {
      $uids[(int) $entity->getOwnerId()] = TRUE;
    }
  }
  $variables['instructors'] = _barrio_boostrap_5_makehaven_d11_course_instructor_teasers(array_keys($uids));
  $variables['instructor_count'] = count($variables['instructors']);
  $variables['teach_url'] = Url::fromUserInput('/instructor')->toString();
}

/**
 * Implements hook_preprocess_HOOK() for profile.
 *
 * Instructor profile pages (/profile/{id}) rendered the raw entity: a
 * numbered title, a photo, one field label and a topic, with the bio usually
 * empty — while the site knows how many sessions the person has taught,
 * since when, how many people they have taught, which courses, and what is
 * coming up (JR, 2026-09-14: "not very interesting"). Full view only; the
 * /instructors listing and teasers keep their own displays.
 *
 * Sets $variables['instructor'] for profile--instructor--full.html.twig.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_profile(array &$variables): void {
  /** @var \Drupal\profile\Entity\ProfileInterface $profile */
  $profile = $variables['profile'] ?? ($variables['elements']['#profile'] ?? NULL);
  if (!$profile || $profile->bundle() !== 'instructor' || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $owner = $profile->getOwner();
  if (!$owner) {
    return;
  }
  $uid = (int) $owner->id();
  $etm = \Drupal::entityTypeManager();
  $database = \Drupal::database();
  $now = date('Y-m-d H:i:s');
  $data = [
    'name' => _barrio_boostrap_5_makehaven_d11_person_name($owner),
    'photo' => '',
    'topics' => [],
    'bio' => $variables['content']['field_instructor_bio'] ?? NULL,
    'has_bio' => $profile->hasField('field_instructor_bio')
      && _barrio_boostrap_5_makehaven_d11_text_has_content($profile->get('field_instructor_bio')->value),
    'private_available' => FALSE,
    'private_text' => $variables['content']['field_instructor_private_session'] ?? NULL,
    'has_private_text' => $profile->hasField('field_instructor_private_session')
      && _barrio_boostrap_5_makehaven_d11_text_has_content($profile->get('field_instructor_private_session')->value),
    'private_class_url' => Url::fromUserInput('/private-class-inquiry', ['query' => ['instructor' => _barrio_boostrap_5_makehaven_d11_person_name($owner)]])->toString(),
    'stats' => ['sessions' => 0, 'since' => '', 'students' => 0, 'upcoming' => 0, 'rating' => 0.0, 'ratings' => 0],
    'courses' => [],
    'upcoming' => [],
  ];

  if ($profile->hasField('field_instructor_photo') && !$profile->get('field_instructor_photo')->isEmpty()) {
    $file = $profile->get('field_instructor_photo')->entity;
    $style = $etm->getStorage('image_style')->load('medium_square');
    if ($file && $style) {
      $data['photo'] = $style->buildUrl($file->getFileUri());
    }
  }
  if ($profile->hasField('field_instructor_topics')) {
    foreach ($profile->get('field_instructor_topics')->referencedEntities() as $term) {
      $data['topics'][] = $term->label();
    }
  }
  if ($profile->hasField('field_instructor_availability')) {
    $avail = (string) $profile->get('field_instructor_availability')->value;
    $data['private_available'] = $avail !== '' && !in_array(strtolower($avail), ['no', 'none', '0', 'not_available'], TRUE);
  }

  try {
    if ($database->schema()->tableExists('civicrm_event__field_civi_event_instructor')) {
      $event_ids = $database->select('civicrm_event__field_civi_event_instructor', 'i')
        ->fields('i', ['entity_id'])
        ->condition('i.field_civi_event_instructor_target_id', $uid)
        ->execute()->fetchCol();
      if ($event_ids) {
        // Sessions taught, first year, upcoming count.
        $agg = $database->select('civicrm_event', 'e')
          ->condition('e.id', $event_ids, 'IN')
          ->condition('e.is_template', 0);
        $agg->addExpression("SUM(e.start_date <= '$now')", 'past');
        $agg->addExpression("SUM(e.start_date > '$now' AND e.is_active = 1)", 'upcoming');
        $agg->addExpression("MIN(CASE WHEN e.start_date <= '$now' THEN e.start_date END)", 'first');
        $row = $agg->execute()->fetchObject();
        $data['stats']['sessions'] = (int) ($row->past ?? 0);
        $data['stats']['upcoming'] = (int) ($row->upcoming ?? 0);
        $data['stats']['since'] = !empty($row->first) ? date('Y', strtotime($row->first)) : '';

        // People taught: distinct registered/attended participants on past sessions.
        if ($database->schema()->tableExists('civicrm_participant')) {
          $st = $database->select('civicrm_participant', 'p');
          $st->join('civicrm_event', 'e', 'e.id = p.event_id');
          $st->addExpression('COUNT(DISTINCT p.contact_id)', 'students');
          $st->condition('p.event_id', $event_ids, 'IN')
            ->condition('p.status_id', [1, 2], 'IN')
            ->condition('e.start_date', $now, '<=');
          $data['stats']['students'] = (int) $st->execute()->fetchField();
        }

        // Ratings from the event feedback form (same source as course pages).
        $sids = $database->select('webform_submission_data', 'eid')
          ->fields('eid', ['sid'])
          ->condition('eid.webform_id', 'webform_1181')
          ->condition('eid.name', 'event_id')
          ->condition('eid.value', array_map('strval', $event_ids), 'IN')
          ->execute()->fetchCol();
        if ($sids) {
          $ratings = $database->select('webform_submission_data', 'r')
            ->fields('r', ['value'])
            ->condition('r.webform_id', 'webform_1181')
            ->condition('r.name', 'overall_how_satisfied_were_you_with_the_event')
            ->condition('r.sid', $sids, 'IN')
            ->execute()->fetchCol();
          $sum = 0;
          $n = 0;
          foreach ($ratings as $v) {
            $v = (int) $v;
            if ($v >= 1 && $v <= 5) {
              $sum += $v;
              $n++;
            }
          }
          if ($n >= 3) {
            $data['stats']['rating'] = round($sum / $n, 1);
            $data['stats']['ratings'] = $n;
          }
        }

        // Courses they teach: parent course nodes of their events, with runs.
        if ($database->schema()->tableExists('civicrm_event__field_parent_course')) {
          $cq = $database->select('civicrm_event__field_parent_course', 'pc');
          $cq->join('civicrm_event', 'e', 'e.id = pc.entity_id');
          $cq->join('node_field_data', 'n', 'n.nid = pc.field_parent_course_target_id');
          $cq->addField('n', 'nid');
          $cq->addField('n', 'title');
          $cq->addExpression('COUNT(DISTINCT e.id)', 'runs');
          $cq->addExpression("SUM(e.start_date > '$now' AND e.is_active = 1)", 'upcoming');
          $cq->condition('pc.entity_id', $event_ids, 'IN')
            ->condition('e.is_template', 0)
            ->condition('n.status', 1)
            ->groupBy('n.nid')->groupBy('n.title')
            ->orderBy('runs', 'DESC');
          $course_rows = $cq->execute()->fetchAll();
          $nids = array_map(static fn($r) => (int) $r->nid, $course_rows);
          $nodes = $nids ? $etm->getStorage('node')->loadMultiple($nids) : [];
          foreach ($course_rows as $r) {
            $node = $nodes[(int) $r->nid] ?? NULL;
            if (!$node) {
              continue;
            }
            $type = $node->hasField('field_course_type') ? $node->get('field_course_type')->value : NULL;
            $nouns = _barrio_boostrap_5_makehaven_d11_course_nouns($type);
            $image = '';
            if ($node->hasField('field_course_image') && !$node->get('field_course_image')->isEmpty()) {
              $file = $node->get('field_course_image')->entity;
              $style = $etm->getStorage('image_style')->load('medium');
              if ($file && $style) {
                $image = $style->buildUrl($file->getFileUri());
              }
            }
            $data['courses'][] = [
              'title' => $node->label(),
              'url' => $node->toUrl()->toString(),
              'image' => $image,
              'runs' => (int) $r->runs,
              'upcoming' => (int) $r->upcoming,
              'noun' => $nouns,
              'listed' => $node->hasField('field_publicly_listed') && (int) $node->get('field_publicly_listed')->value === 1,
            ];
          }
        }

        // Upcoming sessions.
        $up = $database->select('civicrm_event', 'e')
          ->fields('e', ['id', 'title', 'start_date'])
          ->condition('e.id', $event_ids, 'IN')
          ->condition('e.is_template', 0)
          ->condition('e.is_active', 1)
          ->condition('e.is_public', 1)
          ->condition('e.start_date', $now, '>')
          ->orderBy('e.start_date')
          ->range(0, 6)
          ->execute();
        foreach ($up as $ev) {
          $ts = strtotime($ev->start_date);
          $data['upcoming'][] = [
            'title' => $ev->title,
            'date' => date('D, M j', $ts),
            'time' => date('g:ia', $ts),
            'url' => '/civicrm/event/info?id=' . $ev->id . '&reset=1',
            'register' => '/civicrm/event/register?id=' . $ev->id . '&reset=1',
          ];
        }
      }
    }
  }
  catch (\Throwable $e) {
    // The page still renders with whatever was gathered.
  }

  $variables['instructor'] = $data;
  $variables['#attached']['library'][] = 'barrio_boostrap_5_makehaven_d11/global-styling';
  $variables['#cache']['tags'][] = 'civicrm_event_list';
  $variables['#cache']['max-age'] = 3600;
}

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Collapses the featured-top band when nothing in it renders. Barrio's page
 * template tests `page.featured_top`, which is true whenever a block is
 * PLACED there — the onboarding progress bar is placed on every funnel page
 * but renders nothing for a finished member, or for a signed-out visitor on
 * /user/register who is not the paid-membership hand-off — and the region
 * wrapper carries a grey background and padding, so an empty region showed
 * as a blank band above the breadcrumb (JR, 2026-09-14). Render a copy to
 * find out, keep its cache metadata so a cached page still varies the way
 * the blocks inside asked it to, and drop the region when it is blank.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_page(array &$variables): void {
  if (empty($variables['page']['featured_top'])) {
    return;
  }
  $copy = $variables['page']['featured_top'];
  try {
    $html = (string) \Drupal::service('renderer')->renderInIsolation($copy);
  }
  catch (\Throwable $e) {
    return;
  }
  CacheableMetadata::createFromRenderArray($copy)
    ->merge(CacheableMetadata::createFromRenderArray($variables))
    ->applyTo($variables);
  if (trim(strip_tags($html)) === '') {
    unset($variables['page']['featured_top']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for html.
 *
 * Adds the .mh-banner-page body class on banner pages so the banner +
 * breadcrumb-pill styling (css/pages/rooms.css) can scope to them.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_html(&$variables) {
  if (_barrio_boostrap_5_makehaven_d11_mh_banner_crumb() !== NULL) {
    $variables['attributes']['class'][] = 'mh-banner-page';
  }
  // Instructor profile pages: own hero (profile--instructor--full.html.twig),
  // so hide the theme title block and give the tab the person's name instead
  // of "Instructor #1793".
  $profile = \Drupal::routeMatch()->getParameter('profile');
  if ($profile instanceof \Drupal\profile\Entity\ProfileInterface && $profile->bundle() === 'instructor'
    && \Drupal::routeMatch()->getRouteName() === 'entity.profile.canonical') {
    $variables['attributes']['class'][] = 'page-profile--instructor';
    if ($profile->getOwner()) {
      $variables['head_title']['title'] = _barrio_boostrap_5_makehaven_d11_person_name($profile->getOwner());
    }
  }
  // Course pages: .page-course (+ .page-course--{type}) so css/pages/course.css
  // can hide the duplicate theme page title on every course page and give
  // program pages the full-bleed landing layout.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && $node->bundle() === 'course'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['attributes']['class'][] = 'page-course';
    $type = $node->hasField('field_course_type') ? $node->get('field_course_type')->value : NULL;
    if ($type) {
      $variables['attributes']['class'][] = 'page-course--' . $type;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.
 *
 * On banner pages, inject the breadcrumb pill into the page-title block so the
 * pill and heading render as one contiguous banner (the standalone theme
 * breadcrumb block is hidden via CSS). Reuses the .mh-page__crumb pill style.
 */
function barrio_boostrap_5_makehaven_d11_preprocess_block(&$variables) {
  if (($variables['plugin_id'] ?? '') !== 'page_title_block') {
    return;
  }
  $crumb = _barrio_boostrap_5_makehaven_d11_mh_banner_crumb();
  if (!$crumb) {
    return;
  }
  $last = count($crumb) - 1;
  $items = '';
  foreach ($crumb as $i => [$text, $url]) {
    $text = \Drupal\Component\Utility\Html::escape($text);
    if ($url !== NULL && $i !== $last) {
      $items .= '<li class="breadcrumb-item"><a href="' . \Drupal\Component\Utility\Html::escape($url) . '">' . $text . '</a></li>';
    }
    else {
      $items .= '<li class="breadcrumb-item active" aria-current="page">' . $text . '</li>';
    }
  }
  $html = '<nav aria-label="breadcrumb" class="mh-rooms-crumb"><ol class="breadcrumb mh-page__crumb">' . $items . '</ol></nav>';
  $variables['content']['#prefix'] = $html . ($variables['content']['#prefix'] ?? '');
  $variables['#cache']['contexts'][] = 'url.path';
}

